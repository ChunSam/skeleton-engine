// Particle emitters for examples/anim_effects.rs, loaded with `App::load_particle_configs`.
//
// The anim-effect bindings (anim_effects.ron) reference "dust" by name: a `SpawnParticles` effect
// looks the emitter up here and fires a one-shot burst (its continuous emission is ignored). So the
// footstep puff's look is data-driven too — retune it by editing this file.
(
    emitters: {
        // A soft kicked-up dust puff: light brown, drifts up then settles under gravity.
        "dust": (
            lifetime: 0.55,
            velocity: (0.0, -60.0),
            velocity_spread: (150.0, 90.0),
            color_start: (0.9, 0.85, 0.66, 0.95),
            color_end: (0.7, 0.66, 0.55, 0.0),
            size: (6.0, 6.0),
            gravity: (0.0, 130.0),
            emit_shape: Circle(radius: 12.0),
        ),
    },
)
