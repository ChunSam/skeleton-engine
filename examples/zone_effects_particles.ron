// Particle emitters for examples/zone_effects.rs, loaded with `App::load_particle_configs`.
//
// The zone-effect bindings (zone_effects.ron) reference these by name: a `SpawnParticles` effect
// looks the emitter up here and fires a one-shot burst (its continuous emission is ignored). So the
// burst's *look* is data-driven too — retune a reaction's particles by editing this file.
(
    emitters: {
        // Red downward spray — a hit/damage burst.
        "blood": (
            lifetime: 0.55,
            velocity_spread: (120.0, 90.0),
            color_start: (0.95, 0.2, 0.15, 1.0),
            color_end: (0.5, 0.05, 0.05, 0.0),
            size: (5.0, 5.0),
            gravity: (0.0, 320.0),
            emit_shape: Circle(radius: 8.0),
        ),
        // Bright upward twinkle — a heal / goal sparkle.
        "sparkle": (
            lifetime: 0.7,
            velocity: (0.0, -40.0),
            velocity_spread: (90.0, 70.0),
            color_start: (1.0, 0.95, 0.5, 1.0),
            color_end: (0.4, 0.9, 1.0, 0.0),
            size: (4.0, 4.0),
            gravity: (0.0, -60.0),
            emit_shape: Ring(radius: 18.0),
        ),
    },
)
