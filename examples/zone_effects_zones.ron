// Trigger zones for examples/zone_effects.rs (the logical heal / damage / goal regions).
//
// Loaded via `App::load_trigger_zones("level", …)` + spawned with `App::spawn_trigger_zones`.
// What *happens* on entering each zone is authored separately in `zone_effects.ron` (the effect
// bindings) — this file only says *where* the zones are. mask 1 = the player's CollisionLayer.
(
    zones: [
        (tag: "heal",   pos: (190.0, 250.0), shape: Rect(half_extents: (48.0, 64.0)), mask: 1),
        (tag: "damage", pos: (420.0, 250.0), shape: Circle(radius: 64.0),             mask: 1),
        (tag: "goal",   pos: (640.0, 250.0), shape: Rect(half_extents: (48.0, 64.0)), mask: 1),
    ],
)
