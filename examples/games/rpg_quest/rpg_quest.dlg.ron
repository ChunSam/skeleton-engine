// rpg_quest — the merchant's conversation, loaded at runtime via
// `App::load_dialogue("merchant", "examples/games/rpg_quest/rpg_quest.dlg.ron")`.
// Edit this file while the example runs to hot-reload it.
//
// Flow:  intro → ask → { buy → ask2 → [secret?] → bye | nodeal → bye | bye }
//
// Three gates, one of each shape the engine offers — all three written here, in the data, with no
// help from the game:
//
//   * `choice.buy` uses **`cond_all`**: `gold >= 10 && !has_lantern`, the ordinary shop gate.
//     Every listed condition must pass.
//   * `choice.nodeal` uses **`cond_any`**: `gold < 10 || has_lantern`, the exact negation. One
//     listed condition is enough. The two branches are mutually exclusive by construction, so the
//     merchant always has exactly one thing to say.
//   * `choice.secret` uses **`cond`**, the single-term sugar, and carries a `SetVar` effect so
//     reaching the secret records `knows_mine` without the game hearing about it.
//
// The first two used to be one precomputed `can_buy_lantern` flag that the game recalculated every
// frame, because `cond` held exactly one `DialogueCond`. That cost a designer a programmer for
// every two-term gate. `cond_all` / `cond_any` landed in v0.152.0 and this file is what asked for
// them; the flag and the system that maintained it are both gone.
//
// `choice.buy` uses the other effect kind — `EmitEvent` — because buying does *two* things (spend
// the gold, grant the lantern) and a choice carries one effect. The game turns the one event into
// both consequences, which is the engine staying consequence-agnostic on purpose.
(
    speaker_key: "npc.merchant",
    chars_per_sec: 40.0,
    nodes: [
        (id: "intro", line_key: "dlg.intro"),
        (id: "ask", line_key: "dlg.ask", choices: [
            (key: "choice.buy", goto: "buy",
             cond_all: [
                 (var: "gold", op: Ge, value: Int(10)),
                 (var: "has_lantern", op: Eq, value: Bool(false)),
             ],
             effect: EmitEvent(name: "buy_lantern")),
            (key: "choice.nodeal", goto: "nodeal",
             cond_any: [
                 (var: "gold", op: Lt, value: Int(10)),
                 (var: "has_lantern", op: Eq, value: Bool(true)),
             ]),
            (key: "choice.leave", goto: "bye"),
        ]),
        (id: "buy", line_key: "dlg.buy", choices: [
            (key: "choice.more", goto: "ask2"),
        ]),
        (id: "nodeal", line_key: "dlg.nodeal", choices: [
            (key: "choice.more", goto: "ask2"),
        ]),
        (id: "ask2", line_key: "dlg.ask2", choices: [
            (key: "choice.secret", goto: "secret",
             cond: (var: "has_lantern", op: Eq, value: Bool(true)),
             effect: SetVar(key: "knows_mine", value: Bool(true))),
            (key: "choice.leave", goto: "bye"),
        ]),
        (id: "secret", line_key: "dlg.secret", choices: [
            (key: "choice.go", goto: "bye"),
        ]),
        (id: "bye", line_key: "dlg.bye"),
    ],
)
