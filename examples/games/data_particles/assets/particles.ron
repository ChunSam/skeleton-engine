// Data-driven particle emitter configs for the `data_particles` example.
// Each emitter maps directly to a `ParticleEmitter`. Vec2 = (x, y), Color = (r, g, b, a);
// omitted fields fall back to serde defaults. Edit any value and the running example
// hot-reloads the effect live. Y is DOWN, so a negative velocity.y rises on screen.
(
    emitters: {
        "fire": (
            spawn_rate: 90.0, lifetime: 0.7,
            velocity: (0.0, -55.0), velocity_spread: (45.0, 30.0),
            color_start: (1.0, 0.85, 0.35, 1.0), color_end: (1.0, 0.25, 0.1, 0.0),
            size: (8.0, 8.0),
        ),
        "fountain": (
            spawn_rate: 70.0, lifetime: 1.1,
            velocity: (0.0, -130.0), velocity_spread: (55.0, 25.0),
            color_start: (0.4, 0.75, 1.0, 1.0), color_end: (0.2, 0.35, 0.85, 0.0),
            size: (6.0, 6.0),
        ),
        "smoke": (
            spawn_rate: 35.0, lifetime: 1.4,
            velocity: (0.0, -28.0), velocity_spread: (18.0, 12.0),
            color_start: (0.7, 0.7, 0.72, 0.8), color_end: (0.35, 0.35, 0.4, 0.0),
            size: (12.0, 12.0),
        ),
    },
)
