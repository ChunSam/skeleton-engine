// Data-driven animation clips for the `data_anim` example.
// Frame numbers are atlas tile indices into anim.png (a 4x4 grid: index = row*4 + col).
// Edit fps / frames / looping and the running example hot-reloads the animation live.
(
    atlas: (columns: 4, rows: 4),
    clips: {
        "idle": (frames: [0, 1, 2, 3], fps: 4.0, looping: true),
        "run":  (frames: [4, 5, 6, 7], fps: 12.0, looping: true),
        "spin": (frames: [8, 9, 10, 11], fps: 8.0, looping: true),
    },
)
