// dialogue_quest — a localized, data-driven branching quest tree.
//
// Loaded at runtime via `App::load_dialogue("quest", "examples/dialogue_quest.dlg.ron")` and
// flattened to a DialogueBox (node order = line index, `goto` ids resolve to indices). Edit
// this file while the example runs to see it hot-reload.
//
// Flow:  intro → ask → { buy → ask2 → [secret?] → bye | leave → bye }
//   - "buy" carries an EmitEvent effect; the game grants the lantern (sets `has_lantern`).
//   - the "secret" choice at ask2 is gated on `has_lantern == true`, so it only appears once
//     you've bought the lantern.
(
    speaker_key: "npc.merchant",
    chars_per_sec: 34.0,
    nodes: [
        (id: "intro", line_key: "dlg.intro"),
        (id: "ask", line_key: "dlg.ask", choices: [
            (key: "choice.buy",   goto: "buy", effect: EmitEvent(name: "grant_lantern")),
            (key: "choice.leave", goto: "bye"),
        ]),
        (id: "buy", line_key: "dlg.buy", choices: [
            (key: "choice.more", goto: "ask2"),
        ]),
        (id: "ask2", line_key: "dlg.ask2", choices: [
            (key: "choice.secret", goto: "secret",
             cond: (var: "has_lantern", op: Eq, value: Bool(true))),
            (key: "choice.leave", goto: "bye"),
        ]),
        (id: "secret", line_key: "dlg.secret", choices: [
            (key: "choice.go", goto: "bye"),
        ]),
        (id: "bye", line_key: "dlg.bye"),
    ],
)
